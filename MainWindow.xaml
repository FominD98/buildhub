<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:BuildHub"
        xmlns:gif="https://github.com/XamlAnimatedGif/XamlAnimatedGif"
        xmlns:av="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="av" x:Class="BuildHub.MainWindow"
        Title="BuildHub"
        Height="800"
        Width="1400"
        MinWidth="1200"
        MinHeight="600"
        AllowsTransparency="True"
        WindowStyle="None"
        Background="Transparent"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        ResizeMode="CanResize">

    <Window.Resources>
        <local:RectConverter x:Key="RectConverter"/>
        <!-- Стиль для кнопок управления окном -->
        <Style x:Key="WindowControlButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#30FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для элементов списка проектов -->
        <Style x:Key="ProjectItemStyle" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="#20FFFFFF"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#30FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <!-- Основной контейнер с закругленными углами -->
    <Border Background="#E6000000"
            CornerRadius="20"
            BorderThickness="1"
            BorderBrush="#40FFFFFF">

        <!-- Клип для обрезки содержимого по закругленным углам -->
        <Border.Clip>
            <RectangleGeometry RadiusX="20" RadiusY="20">
                <RectangleGeometry.Rect>
                    <MultiBinding Converter="{StaticResource RectConverter}">
                        <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType={x:Type Border}}"/>
                        <Binding Path="ActualHeight" RelativeSource="{RelativeSource AncestorType={x:Type Border}}"/>
                    </MultiBinding>
                </RectangleGeometry.Rect>
            </RectangleGeometry>
        </Border.Clip>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Шапка с заголовком и кнопками управления -->
            <Grid Grid.Row="0" Background="#15FFFFFF">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Логотип и название -->
                <StackPanel Grid.Column="0"
                           Orientation="Horizontal"
                           VerticalAlignment="Center"
                           Margin="20,0">
                    <Border Background="#7C3AED"
                            Width="32"
                            Height="32"
                            CornerRadius="6"
                            Margin="0,0,10,0">
                        <TextBlock Text="B"
                                  FontSize="20"
                                  FontWeight="Bold"
                                  Foreground="Black"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="BuildHub"
                              FontSize="18"
                              FontWeight="SemiBold"
                              Foreground="White"
                              VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Кнопки управления окном -->
                <StackPanel Grid.Column="2"
                           Orientation="Horizontal"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0">
                    <Button Content="─"
                           Style="{StaticResource WindowControlButtonStyle}"
                           Click="MinimizeButton_Click"
                           ToolTip="Minimize"/>
                    <Button Content="□"
                           Style="{StaticResource WindowControlButtonStyle}"
                           Click="MaximizeButton_Click"
                           ToolTip="Maximize"/>
                    <Button Content="✕"
                           Style="{StaticResource WindowControlButtonStyle}"
                           Click="CloseButton_Click"
                           ToolTip="Close"/>
                </StackPanel>

                <!-- Аватар пользователя -->
            </Grid>

            <!-- Основной контент: слева - список проектов, справа - рабочая зона -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="350"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Левая панель - список проектов -->
                <Border Grid.Column="0"
                       BorderBrush="#20FFFFFF"
                       BorderThickness="0,0,1,0">
                    <Border.Background>
                        <ImageBrush ImageSource="img/back.jpg"
                                   Stretch="UniformToFill"
                                   Opacity="0.3"/>
                    </Border.Background>
                    <Grid Margin="20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Поле поиска -->
                        <Border Grid.Row="0"
                               Background="#20FFFFFF"
                               CornerRadius="8"
                               Padding="12,8"
                               Margin="0,0,0,20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                          Text="🔎"
                                          Foreground="White"
                                          FontSize="16"
                                          VerticalAlignment="Center"
                                          Margin="0,0,8,0"/>
                                <TextBox Grid.Column="1"
                                        x:Name="SearchTextBox"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Foreground="White"
                                        FontSize="14"
                                        VerticalAlignment="Center"
                                        Text="Search"/>
                            </Grid>
                        </Border>

                        <!-- Заголовок секций -->
                        <StackPanel Grid.Row="1" Margin="0,0,0,10">
                            <TextBlock Text="Today"
                                      FontSize="14"
                                      FontWeight="SemiBold"
                                      Foreground="#AAAAAA"
                                      Margin="0,0,0,10"/>
                        </StackPanel>

                        <!-- Список проектов -->
                        <ScrollViewer Grid.Row="2"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <!-- Элемент списка проекта (пример) -->
                                <Border Style="{StaticResource ProjectItemStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                  Text="Tell us about your capabilities"
                                                  FontSize="13"
                                                  Foreground="White"
                                                  TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="1"
                                                  Text="⋯"
                                                  FontSize="16"
                                                  Foreground="#AAAAAA"
                                                  VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <!-- Вчера -->
                                <TextBlock Text="Yesterday"
                                          FontSize="14"
                                          FontWeight="SemiBold"
                                          Foreground="#AAAAAA"
                                          Margin="0,20,0,10"/>

                                <Border Style="{StaticResource ProjectItemStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                  Text="Tell us about your capabilities"
                                                  FontSize="13"
                                                  Foreground="White"
                                                  TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="1"
                                                  Text="⋯"
                                                  FontSize="16"
                                                  Foreground="#AAAAAA"
                                                  VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <!-- 3 дня назад -->
                                <TextBlock Text="3 days ago"
                                          FontSize="14"
                                          FontWeight="SemiBold"
                                          Foreground="#AAAAAA"
                                          Margin="0,20,0,10"/>

                                <Border Style="{StaticResource ProjectItemStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                  Text="Tell us about your capabilities"
                                                  FontSize="13"
                                                  Foreground="White"
                                                  TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="1"
                                                  Text="⋯"
                                                  FontSize="16"
                                                  Foreground="#AAAAAA"
                                                  VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <!-- 7 дней назад -->
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Баннер подписки внизу -->
                    </Grid>
                </Border>

                <!-- Правая панель - рабочая зона -->
                <Grid Grid.Column="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="433*"/>
                        <ColumnDefinition Width="91*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Анимированная иконка на заднем фоне -->
                    <Image gif:AnimationBehavior.SourceUri="img/main.gif"
                           gif:AnimationBehavior.CacheFramesInMemory="True"
                           gif:AnimationBehavior.AutoStart="True"
                           RenderOptions.BitmapScalingMode="LowQuality"
                           Width="400"
                           Height="400"
                           VerticalAlignment="Top"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,0"
                           Stretch="Uniform"
                           Opacity="0.9"
                           Grid.ColumnSpan="2"/>

                    <!-- Центральная welcome секция -->
                    <StackPanel VerticalAlignment="Top"
                               HorizontalAlignment="Center"
                               Margin="0,234,0,0" Grid.ColumnSpan="2">

                        <!-- Приветственный текст -->
                        <TextBlock Text="Добро пожаловать, исследователь!"
                                  FontSize="42"
                                  FontWeight="Bold"
                                  HorizontalAlignment="Center"
                                  Margin="0,0,0,10">
                            <TextBlock.Foreground>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#FFF5F0" Offset="0"/>
                                    <GradientStop Color="#FFDAB9" Offset="0.5"/>
                                    <GradientStop Color="#EC4899" Offset="1"/>
                                </LinearGradientBrush>
                            </TextBlock.Foreground>
                        </TextBlock>

                        <TextBlock Text="Что вы хотите проанализировать сегодня?"
                                  FontSize="16"
                                  Foreground="#AAAAAA"
                                  HorizontalAlignment="Center"
                                  Margin="0,0,0,40"/>

                        <!-- Панель с опциями -->
                        <Grid HorizontalAlignment="Center" Width="800">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Input область -->
                            <Border Background="#15FFFFFF"
                                   CornerRadius="12"
                                   Padding="20"
                                   BorderBrush="#30FFFFFF"
                                   BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- AI Indicator -->
                                    <StackPanel Grid.Column="0"
                                              Orientation="Horizontal"
                                              VerticalAlignment="Center"
                                              Margin="0,0,15,0">
                                        <Border Background="#30FFFFFF"
                                               CornerRadius="6"
                                               Padding="8,4">
                                            <TextBlock Text="💻 Base agent"
                                                      FontSize="11"
                                                      Foreground="#FFDD6C21"
                                                      FontWeight="SemiBold"/>
                                        </Border>
                                    </StackPanel>

                                    <!-- Текстовое поле -->
                                    <TextBox Grid.Column="1"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Foreground="#AAAAAA"
                                            FontSize="14"
                                            VerticalAlignment="Center"
                                            Text="Расскажите нам о своих возможностях"/>

                                    <!-- Кнопка отправки -->
                                    <Button Grid.Column="2"
                                           Background="#7C3AED"
                                           Width="40"
                                           Height="40"
                                           BorderThickness="0"
                                           Cursor="Hand" Foreground="White">
                                        <Button.Template>
                                            <ControlTemplate TargetType="{x:Type Button}">
                                                <Border Background="{TemplateBinding Background}"
                                                       CornerRadius="20"
                                                       Width="{TemplateBinding Width}"
                                                       Height="{TemplateBinding Height}">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                    VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#E5B730"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <TextBlock Text="→"
                                                  FontSize="30"
                                                  Foreground="White"
                                                  FontWeight="Bold" Height="39" FontFamily="Arial Black"/>
                                    </Button>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- Быстрые действия -->
                        <StackPanel Orientation="Horizontal"
                                   HorizontalAlignment="Center"
                                   Margin="0,30,0,0">
                            <!-- Поиск поставщиков -->
                            <Border Background="#15FFFFFF"
                                   CornerRadius="10"
                                   Padding="20,15"
                                   Margin="0,0,15,0"
                                   Width="250"
                                   Cursor="Hand">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Row="0" Grid.RowSpan="2"
                                           Background="#7C3AED"
                                           Width="40"
                                           Height="40"
                                           CornerRadius="8"
                                           VerticalAlignment="Center"
                                           Margin="0,0,12,0">
                                        <TextBlock Text="🚚"
                                                  FontSize="20"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" Foreground="White"/>
                                    </Border>

                                    <TextBlock Grid.Row="0" Grid.Column="1"
                                              Text="Search"
                                              FontSize="14"
                                              FontWeight="SemiBold"
                                              Foreground="White"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1"
                                              Text="for suppliers"
                                              FontSize="12"
                                              Foreground="#AAAAAA"
                                              Margin="0,2,0,0"/>
                                </Grid>
                            </Border>

                            <!-- Выбор материалов -->
                            <Border Background="#15FFFFFF"
                                   CornerRadius="10"
                                   Padding="20,15"
                                   Margin="0,0,15,0"
                                   Width="250"
                                   Cursor="Hand">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Row="0" Grid.RowSpan="2"
                                           Background="#7C3AED"
                                           Width="40"
                                           Height="40"
                                           CornerRadius="8"
                                           VerticalAlignment="Center"
                                           Margin="0,0,12,0">
                                        <TextBlock Text="💎"
                                                  FontSize="20"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" Foreground="White"/>
                                    </Border>

                                    <TextBlock Grid.Row="0" Grid.Column="1"
                                              Text="Select materials"
                                              FontSize="14"
                                              FontWeight="SemiBold"
                                              Foreground="White"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1"
                                              Text="Build from scratch"
                                              FontSize="12"
                                              Foreground="#AAAAAA"
                                              Margin="0,2,0,0"/>
                                </Grid>
                            </Border>

                            <!-- Расчет стоимости -->
                            <Border Background="#15FFFFFF"
                                   CornerRadius="10"
                                   Padding="20,15"
                                   Width="250"
                                   Cursor="Hand">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Row="0" Grid.RowSpan="2"
                                           Background="#7C3AED"
                                           Width="40"
                                           Height="40"
                                           CornerRadius="8"
                                           VerticalAlignment="Center"
                                           Margin="0,0,12,0">
                                        <TextBlock Text="💰"
                                                  FontSize="20"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" Foreground="White"/>
                                    </Border>

                                    <TextBlock Grid.Row="0" Grid.Column="1"
                                              Text="Calculation"
                                              FontSize="14"
                                              FontWeight="SemiBold"
                                              Foreground="White"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1"
                                              Text="of the cost"
                                              FontSize="12"
                                              Foreground="#AAAAAA"
                                              Margin="0,2,0,0"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>